  volume = {26},
  pages = {1193--1214},
  number = {7--8},
  abstract = {Land use planning systems in Australia and the United Kingdom (UK)
	share a common history. In both nations, one objective of town planning
	has been to improve housing conditions for the urban poor and facilitate
	sufficient housing supply for growing post-war populations, with
	UK legislation serving as a model for Australia, at least until the
	Town and Country Planning Act 1947. Since this time however, approaches
	have diverged. In the UK, housing assistance and the land use planning
	system have co-evolved, with planning an important tool for securing
	affordable housing, particularly in England. In contrast, a deep
	cleavage between urban planning and housing policy persists in Australia.
