  volume = {54},
  pages = {671--699},
  number = {4},
  abstract = {This paper demonstrates that, in the context of U.S. housing data,
	rents and ex ante user costs diverge markedly�in both growth rates
	and levels�for extended periods of time, a seeming failure of arbitrage
	and a puzzle from the perspective of standard capital theory. The
