  volume = {78},
  pages = {126--140},
  number = {2},
  abstract = {The tyranny of distance in terms of its effect on median earnings
	and housing costs is examined for rural and urban U.S. counties.
	First, we develop a series of distance metrics for an area's remoteness
	from multiple tiers of the urban hierarchy. Second, we consider geographical
	access of buyers and sellers through market potential measures typical
	of those used in empirical studies of the New Economic Geography.
	We estimate penalties of about 5 to 9% for median earnings and 12
	to 17% for housing costs for area remoteness from the combined tiers
	of the urban hierarchy. Differences in market potential also influence
