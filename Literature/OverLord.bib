  volume = {113},
  pages = {346--374},
  number = {2},
  abstract = {Urban decline is not the mirror image of growth, and durable housing
	is the primary reason the nature of decline is so different. This
	paper presents a model of urban decline with durable housing and
	verifies these implications of the model: (1) city growth rates are
	skewed so that cities grow more quickly than they decline; (2) urban
	decline is highly persistent; (3) positive shocks increase population
	more than they increase housing prices; (4) negative shocks decrease
