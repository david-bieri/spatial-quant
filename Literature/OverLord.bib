@TECHREPORT{Inmann2008,
  author = {Inmann, Robert P.},
  title = {The Flypaper Effect},
  institution = {National Bureau of Economic Research},
  year = {2008},
  type = {Working Paper},
  number = {No. 14579},
  address = {Cambridge, MA},
  abstract = {The flypaper effect results when a dollar of exogenous grants-in-aid
	leads to significantly greater public spending than an equivalent
	dollar of citizen income: Money sticks where it hits. Viewing governments
	as agents for a representative citizen voter, this empirical result
	is an anomaly. Four alternative explanations have been offered. First,
	it's a data problem; matching grants have been mis-classified as
	exogenous aid. Second, it's an econometric problem; exogenous aid
	is correlated with omitted variables leading to a downward bias in
	estimates of income's effects and an upward bias in estimates of
	aid's effects. Third, it's a specification problem: the representative
	citizen either fails to observe lump-sum aid, or sees aid but mis-perceives
	its impact as an average price effect, or finally, sees and understands
	aid's budgetary effects but allocates "public" and "private" monies
	through separate "mental accounts." The empirical evidence suggests
	none of these explanations is sufficient. A fourth explanation seems
	most promising: It's politics. Rather than an anomaly, the flypaper
	effect is best seen as an outcome of political institutions and the
	associated incentives of elected officials.},
  file = {:C\:\\Users\\cbbadbi\\Documents\\Teaching\\UAP_4714\\Flypaper_Inmann_NBER2008.pdf:PDF},
  keywords = {public finance, taxation, UP510},
  owner = {cbbadbi},
  timestamp = {2009.02.10}
}

