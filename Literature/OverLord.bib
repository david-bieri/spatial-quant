  pages = {46--65},
  number = {1},
  abstract = {This paper develops a model which demonstrates necessary conditions
	for efficient distribution of labor across areas given the presence
	of agglomeration economies and congestion externalities. An indirect
	empirical test for efficient allocation is formulated based on a
	comparison of estimated agglomeration economies with the compensating
	variation in occupation-specific wages needed to attract workers
	to larger cities. The results of this test suggest that there are
