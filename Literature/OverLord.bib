@ARTICLE{Verbrugge2010,
  author = {Verbrugge, Randal J. and Poole, Robert},
  title = {Explaining the Rent-OER Inflation Divergence, 1999-2007},
  journal = {Real Estate Economics},
  year = {2010},
  volume = {38},
  pages = {1--25},
  number = {4},
  abstract = {The CPI produces two key shelter indexes: Rent, and Owner's Equivalent
	Rent (OER). Both are driven by a common data source, market rents.
	Periodically inflation in the Rent index has diverged markedly from
	inflation in the OER index. At the end of 2007, Rent inflation exceeded
	OER inflation by a stunning 1%. Since monetary authorities respond
	strongly to inflation, accurate inflation measurement is crucial,
	and such divergence attracts a lot of attention and prompts many
	to question CPI methods. Understanding why such divergence has occurred
	is accordingly very important. A key difference between these two
	series is that OER indexes are based upon rents which have received
	a utilities adjustment. This adjustment is necessary; but critics
	often claim that it is flawed and causes the Rent-OER inflation divergences.
	This claim is false. Herein, we decompose the Rent-OER inflation
	differential into its various determinants over time. There is only
	one divergence episode -- of only six months duration -- which is
	primarily attributable to the utilities adjustment procedure. Indeed,
	the utilities adjustment often reduced potential divergence between
	the two series. Instead, the main culprit is rental market segmentation;
	that is, different rent inflation rates were experienced by different
	parts of the rental market. It is not surprising that different cities
	experience different rent inflation; what is surprising, perhaps,
	is that such inflation divergence across cities can cause divergence
	between aggregate Rent and OER inflation. More surprising still is
	the extent to which different areas within the same city experience
	different rent inflation. This phenomenon has scarcely been noticed,
	and its importance for inflation measurement has never been studied
	-- or even suggested -- prior to this study. However, such divergence
	in inflation can cause Rent and OER inflation to diverge, since the
	index aggregation weights placed on particular rental units in the
	city differ across these indexes in systematic ways. In 2007, for
	example, we found a striking pattern which is replicated across most
	cities in the country: the inflation experienced by rental units
	in heavily owner-occupied regions was significantly lower than the
	rent inflation experienced by other units. Even more surprising are
	two findings related to the influence of rent-control. First, although
	rent-control plays a major role in only three large metropolitan
	areas, rent-controlled units influenced national Rent inflation over
	this period. Second, the direction of this influence was positive;
	in other words, rent control units experienced higher inflation than
	other rental units during this period.},
  file = {:C\:\\Users\\cbbadbi\\Documents\\Papers\\RentOERInflation_Verbruegge_REE10.pdf:PDF},
  keywords = {regional real estate},
  owner = {cbbadbi},
  timestamp = {2010.11.16}
}

