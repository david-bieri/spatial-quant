  author = {Trabandt, Mathias and Uhlig, Harald},
  abstract = {We seek to understand how Laffer curves differ across countries in
	the US and the EU-14, thereby providing insights into fiscal limits
	for government spending and the service of sovereign debt. As an
	application, we analyze the consequences for the permanent sustainability
	of current debt levels, when interest rates are permanently increased
	e.g. due to default fears. We build on the analysis in Trabandt and
	Uhlig (2011) and extend it in several ways. To obtain a better fit
	to the data, we allow for monopolistic competition as well as partial
	taxation of pure profit income. We update the sample to 2010, thereby
	including recent increases in government spending and their fiscal
	consequences. We provide new tax rate data. We conduct an analysis
	for the pessimistic case that the recent fiscal shifts are permanent.
	We include a cross-country analysis on consumption taxes as well
	as a more detailed investigation of the inclusion of human capital
	considerations for labor taxation.},
