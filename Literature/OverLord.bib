@TECHREPORT{Baldwin2007,
  author = {Baldwin, Richard E. and Harrigan, James},
  title = {Zeros, Quality and Space: Trade Theory and Trade Evidence},
  institution = {National Bureau of Economic Research},
  year = {2007},
  type = {Working Paper},
  number = {No. 13214},
  address = {Cambridge, MA},
  abstract = {Product-level data on bilateral U.S. exports exhibit two strong patterns.
	First, most potential export flows are not present, and the incidence
	of these "export zeros" is strongly correlated with distance and
	importing country size. Second, export unit values are positively
	related to distance. We show that the leading multi-good general
	equilibrium trade models are inconsistent with at least some of these
	facts. We also offer direct statistical evidence of the importance
	of trade costs in explaining zeros, using the long-term decline in
	the relative cost of air shipment to identify a difference-in-differences
	estimator. To match these facts, we propose a new version of the
	heterogeneous-firms trade model pioneered by Melitz (2003). In our
	model, high quality firms are the most competitive, with heterogeneous
	quality increasing with firms' heterogeneous cost.},
  file = {:C\:\\Users\\cbbadbi\\Documents\\Papers\\ZerosQualityTrade_Baldwin_NBER07.pdf:PDF},
  keywords = {trade, quality upgrading},
  owner = {cbbadbi},
  timestamp = {2009.02.24}
}

