}

@TECHREPORT{Albouy2011,
  author = {Albouy, David Y. and Hanson, Andrew R.},
  title = {The Geographic Incidence and Welfare Effects of Federal Tax Reform},
  institution = {University of Michigan},
  year = {2011},
  type = {Mimeograph},
  abstract = {Federal taxes penalize individuals for living in high-wage areas,
	while tax-benefits to owner occupied housing subsidize them for living
	in high-cost areas and subsidize the consumption of housing. As a
	result, productive areas are under-populated and housing is consumed
	at inefficiently high levels. Simulation results show the mortgage
	interest and property tax deductions reduce deadweight loss on location
	choice by $23 billion annually or 0.19 percent of national income
	and increase it by $11 billion or 0.09 percent of national income
	on housing consumption. Thus, the net effect of eliminating the deductions
	would not be efficiency improving, unless they were accompanied by
	indexing taxes to local wage levels or costs-ofliving, which would
	eliminate or reduce locational inefficiencies. Cost-of-living indexation
	with deductions in place would reduce locational inefficiency, but
	housing consumption inefficiency would remain.},
  file = {:C\:\\Users\\cbbadbi\\Documents\\Papers\\GeographicIncidenceTaxReform_Albouy_2011.pdf:PDF},
  owner = {cbbadbi},
  timestamp = {2011.07.18}
}

