  volume = {28},
  pages = {1--20},
  number = {1},
  abstract = {When individuals are mobile, utility levels will be equalized across
	space, and equity is not improved by indexing transfers to local
	prices. Indexing is also inefficient, since transfers to high cost
	areas buy less. The true rationale for indexing is that optimal transfer
	
