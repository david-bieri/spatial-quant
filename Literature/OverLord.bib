@TECHREPORT{Pope2008a,
  author = {Pope, Devin G. and Pope, Jaren C.},
  title = {Crime and Property Values: Evidence from the 1990's Crime Drop},
  institution = {The Wharton School and Virginia Tech},
  year = {2008},
  type = {Mimeograph},
  abstract = {Crime has many direct and indirect costs. Property values can be influenced
	by crime and therefore may be used to provide a market-based measurement
	of some of the costs of crime. To date, the literature on the influence
	of crime on property values, has focused only within a single metropolitan
	area and has been limited primarily to cross-sectional analysis.
	In this study we exploit the dramatic, nationwide decrease in crime
	that occurred in the 1990s, to estimate the relationship between
	changes in crime rates and property values. To do this, we compile
	information on changes in property values and crime between 1990
	and 2000 in nearly 3000 urban zip codes throughout the U.S. Using
	a fixed-effects framework as well as an instrumental variables strategy,
	our analysis implies a large and statistically significant association
	between crime and housing values. The estimated elasticities of housing
	values with respect to crime range from -0.15 to -0.35. These effects
	suggest that the top decile of zip codes in terms of crime reduction
	in our sample saw property value increases of 7-19% between 1990
	and 2000. Both the empirical analysis and a graphical analysis suggest
	that causality runs from decreasing crime to increasing property
	values. These results provide evidence that the reduction in crime
	is a major contributor to the resurgence of cities over the last
	15 years.},
  file = {:C\:\\Users\\cbbadbi\\Documents\\Projects\\TieboutSorting\\Literature\\CrimePropertyValues_Pope_NARSC.pdf:PDF},
  keywords = {crime, Tiebout sorting, hedonics},
  owner = {cbbadbi},
  timestamp = {2008.11.15}
}

