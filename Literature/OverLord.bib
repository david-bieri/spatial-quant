  address = {New York City},
  abstract = {U.S. households' debt skyrocketed between 2000 and 2007, and has been
	falling since. This leveraging (and deleveraging) cycle cannot be
	accounted for by the liberalization, and subsequent tightening, of
	credit standards in mortgage markets observed during the same period.
