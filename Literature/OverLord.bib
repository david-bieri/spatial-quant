  journal = {Review of Economic Studies},
  year = {2012},
  volume = {forthcoming},
  abstract = {We study the interactions among geographical mobility, unemployment
	and home-ownership in an economy with heterogeneous locations, endogenous
	construction and search frictions in the markets for both labour
	and housing. The decision of home-owners to accept job offers from
	other cities depends on how quickly they can sell their houses (i.e.
	the houses' liquidity), which in turn depends on local labour market
	conditions. Consequently, home-owners accept job offers from other
	cities at a lower rate than do renters, generating a link between
	home-ownership unemployment both at the city-level and in the aggregate.
