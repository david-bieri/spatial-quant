@TECHREPORT{Benjamin2013,
  author = {Benjamin, Daniel J. and Heffetz, Ori and Kimball, Miles S. and Rees-Jones,
	Alex},
  title = {Can Marginal Rates of Substitution Be Inferred from Happiness Data?
